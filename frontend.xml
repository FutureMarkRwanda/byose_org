);

const CTip = ({ active, payload, label, cur }) => {
  if (!active||!payload?.length) return null;
  return (
    <div className="bg-[#1A2E2A] text-white text-xs rounded-xl px-3 py-2.5 shadow-xl border border-white/10 max-w-[220px]">
