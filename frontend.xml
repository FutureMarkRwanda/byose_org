      <div style={{ display:'flex', alignItems:'center', justifyContent:'center', gap: mobile ? 3 : 7, flexWrap: mobile ? 'wrap' : 'nowrap', position:'relative', zIndex:2, padding: mobile ? '0 0 24px' : '6px 0 32px', rowGap: mobile ? 24 : 7 }}>
