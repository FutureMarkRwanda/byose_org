    {loading ? (
      <><Sk cls="h-6 w-16 mb-1.5"/><Sk cls="h-3 w-24 mb-1"/><Sk cls="h-3 w-16"/></>
    ) : (
      <>
        <p className="text-xl sm:text-2xl font-black text-[#1A2E2A]">{value??'—'}</p>
