}

.fullscreen-button:hover {
  background-color: rgba(31, 45, 61, 1);
  transform: scale(1.1);
}

/* Presentation container */
.presentation-container {
  position: relative;
  width: 100%;
  height: 100vh;
}

/* Slide entrance animations */
@keyframes slideEntrance {
  from { opacity: 0; transform: translateY(-50px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideEntranceDelayed {
  0% { opacity: 0; transform: translateY(30px); }
  50% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes bounceFadeIn {
  0% { opacity: 0; transform: scale(0.3); }
  50% { opacity: 0.7; transform: scale(1.1); }
  70% { opacity: 0.8; transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes fadeInRight {
  from { opacity: 0; transform: translateX(-50px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes zoomIn {
  from { opacity: 0; transform: scale(0.5); }
  to { opacity: 1; transform: scale(1); }
}

/* Apply animations to elements */
.slide-entrance {
  animation: slideEntrance 0.8s ease forwards;
}

.slide-entrance-delayed {
  animation: slideEntranceDelayed 1.2s ease forwards;
}

.slide-entrance-delayed-2 {
  animation: slideEntranceDelayed 2s ease forwards;
}

.slide-bounce {
  animation: bounceFadeIn 1s ease forwards;
}

.slide-fade-right {
  animation: fadeInRight 0.8s ease forwards;
}

.slide-zoom-in {
  animation: zoomIn 0.8s ease forwards;
}

/* Feature list animations */
.feature-list {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-item {
  animation: fadeInUp 1s ease-in-out;
}

.feature-item:nth-child(1) {
  animation-delay: 0.3s;
}

.feature-item:nth-child(2) {
  animation-delay: 0.6s;
}

.feature-item:nth-child(3) {
  animation-delay: 0.9s;
}

.feature-item:nth-child(4) {
  animation-delay: 1.2s;
}

.feature-item:nth-child(5) {
  animation-delay: 1.5s;
}
.feature-item {
  animation: fadeInUp 1s ease-in-out;
}

.feature-item:nth-child(6) {
  animation-delay: 0.3s;
}

.feature-item:nth-child(7) {
  animation-delay: 0.6s;
}

.feature-item:nth-child(8) {
  animation-delay: 0.9s;
}

.feature-item:nth-child(9) {
  animation-delay: 1.2s;
}

.feature-item:nth-child(10) {
  animation-delay: 1.5s;
}
.feature-item {
  animation: fadeInUp 1s ease-in-out;
}

.feature-item:nth-child(11) {
  animation-delay: 0.3s;
}

.feature-item:nth-child(12) {
  animation-delay: 0.6s;
}

.feature-item:nth-child(13) {
  animation-delay: 0.9s;
}

.feature-item:nth-child(14) {
  animation-delay: 1.2s;
}

.feature-item:nth-child(15) {
  animation-delay: 1.5s;
}

/* Text block fade-in sequence */
.fade-in-sequence > * {
  opacity: 0;
  animation: slideEntrance 0.5s ease forwards;
}

.fade-in-sequence > *:nth-child(1) {
  animation-delay: 0.3s;
}

.fade-in-sequence > *:nth-child(2) {
  animation-delay: 0.6s;
}

/* Customize spectacle slide transitions */
.spectacle-slide {
  transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

/* Add this to your global CSS file */

/* Hide scrollbar for Chrome, Safari and Opera */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* Hide scrollbar for IE, Edge and Firefox */
* {
  -ms-overflow-style: none;  /* IE and Edge */
